# Kioku app environment (per-package on purpose: Next.js loads .env from this dir)
# Copy to .env. Never commit .env.

# Postgres 16 — matches the root docker-compose.yml (host port 5433 → container 5432).
DATABASE_URL=postgres://kioku:kioku@localhost:5433/kioku

# Auth.js (next-auth v4). Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Uploaded audio storage root (files land under STORAGE_DIR/<workspace>/<meeting>.<ext>).
STORAGE_DIR=/home/aman/projects/saas/data/audio

# Optional — Google sign-in appears only when both are set (plan §5):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# New-workspace retention in days. 90 mirrors the cloud-free default; leave
# empty to keep meetings forever (the self-host default). Existing workspaces
# keep their stored value — this only applies at first provisioning.
DEFAULT_RETENTION_DAYS=90
