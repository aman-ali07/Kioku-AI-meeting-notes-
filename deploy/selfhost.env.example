# Kioku self-host environment — copied to .env (repo root) next to
# docker-compose.selfhost.yml. NEVER commit the real values.

# Postgres superuser password for the SELFHOST stack (dev compose keeps its
# own kioku:kioku; do not reuse credentials across environments).
POSTGRES_PASSWORD=

# Auth.js signing secret — MUST be non-empty in anything user-facing:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# The public origin users actually visit (through the proxy). With a public
# domain + DNS this gives automatic TLS via Caddy; on a LAN box use the raw
# http://<lan-ip>[:port] form.
NEXTAUTH_URL=https://meet.example.com

# Caddy site address — the proxy listens on host ports 80/443 (HTTP_BIND/
# HTTPS_BIND). Give the plain host name for automatic TLS (public DNS,
# e.g. meet.example.com), or an explicit http://host for plain HTTP
# (localhost/LAN tests — Caddy otherwise 308-redirects to HTTPS).
SITE=meet.example.com

# Host ports the proxy binds (override for local tests, e.g. HTTP_BIND=8080).
HTTP_BIND=80
HTTPS_BIND=443

# Whisper model for the worker (optional; small is the verified default).
WHISPER_MODEL=small
