# Kioku worker environment. Copy to worker/.env — never commit .env.
# Postgres 16 on host port 5433 (matches root docker-compose.yml).
DATABASE_URL=postgres://kioku:kioku@localhost:5433/kioku

# Where uploaded meeting audio lives — MUST match app/.env STORAGE_DIR (the
# worker reads files the app writes).
STORAGE_DIR=/home/aman/projects/saas/data/audio
